# Boot images are binary -- never diff or convert them.
*.img        binary
*.tar        binary
*.tar.md5    binary
*.apk        binary
*.png        binary

# Everything else is text; keep it LF in the repository.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.patch text eol=lf
*.config text eol=lf
