# Copy to /etc/telegram-sms/config.env (mode 0600) and fill in.
#
# BOT_TOKEN comes from @BotFather. CHAT_ID is the chat to deliver to:
#   * a group/supergroup id is negative, e.g. -1004411422373
#   * a private chat id is a plain positive number, e.g. 1057234677
#
# To discover CHAT_ID, message the bot once (or add it to the group and post), then
# run `telegram-updates` on the container.
#
# Leave CHAT_ID empty and the sender will keep the snapshot and forward nothing,
# rather than guessing or dropping messages.

BOT_TOKEN=
CHAT_ID=
